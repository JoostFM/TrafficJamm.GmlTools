{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/gml-conversion-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithProperty" ]
  },
  "GmlConversion": {
    "SourceDirectory": "D:\\JammFM\\GML\\Dump\\Xml",
    "SourceFileName": "20260515.GML.DbDump.xml",
    "TargetDirectory": "D:\\JammFM\\GML\\GmlTrackIndex"
  }
}
