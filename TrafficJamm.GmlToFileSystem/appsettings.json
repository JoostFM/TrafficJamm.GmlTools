{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "MinimumLevel": "Information",
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "../../logs/gml-conversion-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}",
          "retainedFileCountLimit": 100,
          "retainedFileTimeLimit": "90.00:00:00"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "TrafficJamm.GmlToFileSystem"
    }
  },
  "GmlToFileSystemSettings": {
    "DumpFileLocation": "D:\\JammFM\\GML\\Dump\\Xml",
    "AudioSourceLocation": "E:\\Items",
    "AudioTargetLocation": "D:\\JammFM\\GML\\GmlTrackIndex"
  }
}
